{
  "appId": "cl.datoya.app",
  "appName": "DatoYa",
  "webDir": "capacitor-www",
  "server": {
    "url": "https://datoya.cl",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "datoya.cl",
      "www.datoya.cl",
      "*.datoya.cl",
      "datoya.onrender.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0B3A82"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1400,
      "launchAutoHide": true,
      "backgroundColor": "#0B3A82",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#FFFFFF",
      "overlaysWebView": false
    }
  }
}
